# -----------------------------------------------------------
# ROLVIO ENVIRONMENT EXAMPLE
# Never place real secrets in this file.
# -----------------------------------------------------------

ROLVIO_ENV=development

# Application data override (optional)
ROLVIO_DATA_DIR=

# AI
ROLVIO_AI_PROVIDER=ollama
ROLVIO_OLLAMA_BASE_URL=http://localhost:11434
ROLVIO_MODEL_NAME=

# NORVI licensing
NORVI_API_URL=
NORVI_PRODUCT_SLUG=rolvio

# Logging
ROLVIO_LOG_LEVEL=INFO
